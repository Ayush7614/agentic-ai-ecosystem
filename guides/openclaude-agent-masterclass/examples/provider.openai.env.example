# Fastest OpenAI-compatible setup (export before openclaude)
# Docs: https://openclaude.gitlawb.com/docs/quickstart/

export CLAUDE_CODE_USE_OPENAI=1
export OPENAI_API_KEY=sk-your-key-here
export OPENAI_MODEL=gpt-4o

# Local Ollama instead:
# export CLAUDE_CODE_USE_OPENAI=1
# export OPENAI_BASE_URL=http://localhost:11434/v1
# export OPENAI_MODEL=qwen2.5-coder:7b

# Or use /provider inside OpenClaude (recommended) — saves .openclaude-profile.json
