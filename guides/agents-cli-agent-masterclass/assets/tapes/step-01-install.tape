Output ../step-01-install-verify.gif

Require uvx

Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 520
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 35ms
Set PlaybackSpeed 1.2

Type "# agents-cli v1.0.0 — verified install (uvx)"
Enter
Sleep 800ms
Type "uvx google-agents-cli --version"
Enter
Sleep 3s
Type "uvx google-agents-cli --help | head -20"
Enter
Sleep 4s
