# Optional — only if NOT using `hermes setup --portal`
# Copy to .env for local reference; Hermes stores config in ~/.hermes/

# Anthropic
# ANTHROPIC_API_KEY=

# OpenAI-compatible (Ollama, OpenRouter, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Tool Gateway alternatives (if not on Nous Portal)
# SERPER_API_KEY=
# TAVILY_API_KEY=

# Messaging gateway (optional — Part 6 of tutorial)
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
