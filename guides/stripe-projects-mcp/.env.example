# The MCP server WRITES this file for you when you call provision().
# You normally don't set keys here by hand — that's the whole point.

# Minted by `provision(name, "supermemory")`. A scoped, capped, rotatable key —
# never your Stripe root key.
SUPERMEMORY_API_KEY=

# Other registry providers (also minted on demand):
VECTOR_DB_API_KEY=
EMAIL_API_KEY=

# Where the server writes minted keys (defaults to examples/.env next to server.py)
# AGENT_ENV_FILE=examples/.env

# Where the simulated Stripe Projects backend persists project state
# STRIPE_PROJECTS_STATE=examples/.stripe_projects_state.json
