# Solo Engineer Stack — copy to .env

# ── Shared LLM (all coding agents) ──
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
# Or local: http://localhost:11434/v1 (Ollama) / Colab ngrok URL

# ── 1. Task Master ──
ANTHROPIC_API_KEY=sk-ant-...
TASK_MASTER_PROJECT=pulsefeedback

# ── 2. CrewAI ──
CREWAI_MODEL=gpt-4o
# Uses OPENAI_API_BASE + OPENAI_API_KEY when set

# ── 3. LangGraph orchestrator ──
ORCHESTRATOR_HUMAN_GATE=true

# ── 4. OpenHands ──
LLM_MODEL=gpt-4o
LLM_API_KEY=${OPENAI_API_KEY}
LLM_BASE_URL=${OPENAI_API_BASE}
GITHUB_TOKEN=ghp_...

# ── 5. Aider ──
AIDER_MODEL=openai/gpt-4o

# ── 6. Cline ──
# Configure in Cursor: OpenAI Compatible → OPENAI_API_BASE

# ── 7. n8n ──
N8N_HOST=http://localhost:5678
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# ── 8. Coolify ──
COOLIFY_URL=https://coolify.yourdomain.com
COOLIFY_TOKEN=

# ── 9. PostHog ──
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=http://localhost:8000

# ── 10. Chatwoot ──
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=

# ── PulseFeedback app ──
APP_REPO=https://github.com/YOU/pulsefeedback
APP_URL=https://feedback.yourdomain.com
